# Groq API Key - Get from https://console.groq.com/keys
VITE_GROQ_API_KEY=your_groq_api_key_here

# LLM Model (Groq) - default: llama-3.3-70b-versatile
VITE_LLM_MODEL=llama-3.3-70b-versatile

# Whisper Model (Groq STT) - default: whisper-large-v3
VITE_WHISPER_MODEL=whisper-large-v3

# TTS Provider: 'groq', 'cartesia', or 'google' - default: groq
VITE_TTS_PROVIDER=groq

# Groq TTS Voice: austin, troy, hannah - default: austin
VITE_GROQ_TTS_VOICE=austin

# Groq TTS Model - default: canopylabs/orpheus-v1-english
VITE_GROQ_TTS_MODEL=canopylabs/orpheus-v1-english

# Cartesia TTS Voice ID - default: db6b0ed5-d5d3-463d-ae85-518a07d3c2b4
VITE_CARTESIA_TTS_VOICE=db6b0ed5-d5d3-463d-ae85-518a07d3c2b4

# Google Cloud TTS API Key - Get from https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_TTS_API_KEY=your_google_api_key_here

# Google TTS Voice - default: en-US-Neural2-D
# Other options: en-US-Neural2-C (female), en-US-Standard-D, en-US-Standard-C
# https://docs.cloud.google.com/text-to-speech/docs/chirp3-hd?hl=es
VITE_GOOGLE_TTS_VOICE=en-US-Neural2-D